# Generated data is re-fetchable from public APIs; never commit it.
data/*
results/
*.jsonl

# Credentials. Put the key in secrets/openai.key using the editor, never by
# typing it into a terminal: shell history leaks in ways files do not.
secrets/
*.key
.env
.env.*

__pycache__/
*.py[cod]
.venv/
venv/

.vscode/
.idea/
.DS_Store

# Human annotations are the one exception: they cost hours of expert time and
# cannot be regenerated. Keep them under version control.
!data/gold/
!data/gold/*.jsonl
